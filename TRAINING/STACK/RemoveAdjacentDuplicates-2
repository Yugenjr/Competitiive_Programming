class Pair
{
   int freq;
   char ch;
   Pair( char ch, int freq)
   {
       this.freq= freq;
       this.ch=ch;
   }
}
class Solution {
   public String removeDuplicates(String s, int k)
   {
       StringBuilder ans = new StringBuilder();


       Stack<Pair>st= new Stack<>();


       for( int  i=0;i<s.length();i++)
       {
           char ch = s.charAt(i);


           if( st.size()>0 && st.peek().ch==ch)
           {
               st.peek().freq++;


               if( st.peek().freq==k)
                   st.pop();
           }
           else // st is empty or curr chr is not same
           {
               Pair p = new Pair(ch,1);
               st.push(p);
           }
       }


       while( st.size()>0)
       {
            char ch = st.peek().ch;
            int freq= st.peek().freq;
            st.pop();


            for( int i=1;i<=freq;i++)  // a->3   aaa
            {
               ans.append(ch);
            }
       }
       return ans.reverse().toString();
   }
}
