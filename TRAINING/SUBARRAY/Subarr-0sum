
class Solution {
    // Function to check whether there is a subarray present with 0-sum or not.
    static boolean findsum(int arr[]) 
    {
        HashMap<Integer,Integer>mp= new HashMap<>();
        int sum=0; 
        
        for(int i=0;i<arr.length;i++)
        {
            sum+=arr[i];
            
            if(sum==0)
                return true;
            
            if( mp.containsKey( sum)==true)
                return true;
            else
                mp.put(sum,1);
        }
        return false;
    }
}
