class Solution {
    public ArrayList<Integer> preGreaterEle(int[] arr) {
        // code here
        ArrayList<Integer>ans= new ArrayList<>();
        
        Stack<Integer>st= new Stack<>();
        
        for( int i=0;i<arr.length;i++)
        {
            while( st.size()>0 && st.peek()<=arr[i])
            {
                st.pop();
            }
            if(st.size()==0)
                ans.add(-1);
            else    // st.peek()> arr[i]
                ans.add( st.peek()); 
                
            st.push(arr[i]);
        }
        return ans;
    }
}
