class Solution {
   public int findMaxLength(int[] nums)
   {
       int n =nums.length;
       int sum=0;
       int mx=0;
       HashMap<Integer,Integer>mp= new HashMap<>();
       for( int i=0;i<n;i++)
       {
           sum+=nums[i]==1?1:-1;

           if(sum==0)
               mx=i+1;
           if(mp.containsKey(sum)==true)
               mx= Math.max(mx, i-mp.get(sum));
           if( mp.containsKey(sum)==false)
               mp.put(sum,i);
       }
       return mx;
   }
}
