class Solution {
    public int longestConsecutive(int[] nums) {
        HashMap<Integer,Integer> map= new HashMap<>();
        for(int i:nums)
        { map.put(i,map.getOrDefault(i,0)+1); }
        int co=0;
        int ans=0;
        // -1 0 1
        for(int v:map.keySet())
        {
            if(!map.containsKey(v-1))
            {
                co=1;

                while(map.containsKey(v+1))
                {
                    v+=1;
                    co+=1;
                }
            }
            ans=Math.max(ans,co);
        }
        return ans;
    }
}