class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) 
    {
        ArrayList<Integer>ans= new ArrayList<>();
        int n = arr.length;
        Stack<Integer>st= new Stack<>();
        
        for(int i=0;i<arr.length;i++)
        {
            while(st.size()>0 && arr[ st.peek() ] <= arr[i])
            {
                st.pop();
            }
            
            int prevGreaterElementIndex=-1;
            
            if(st.size()==0)
                prevGreaterElementIndex=-1;
            else
                prevGreaterElementIndex=st.peek();
                
            
            st.push(i);    
            ans.add( i- prevGreaterElementIndex);
        }
        return ans;
    }
}
