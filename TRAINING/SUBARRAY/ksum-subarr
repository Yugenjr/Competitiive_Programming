class Solution {
   public int subarraySum(int[] nums, int k)
   {
       int sum=0,count=0;
       HashMap<Integer,Integer>mp= new HashMap<>();


       for(int i=0;i<nums.length;i++)
       {
           sum+=nums[i];


           if(sum==k)
               count++;
           if(mp.containsKey(sum-k)==true)
               count+=mp.get(sum-k);


           if( mp.containsKey(sum)==false)
               mp.put(sum,1);
           else
               mp.put(sum, mp.get(sum)+1);
       }
       return count;
   }
}
