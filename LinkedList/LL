    public void addFirst(int val)
    {
        Node newNode = new Node(val);

        if (size == 0) {
            head = newNode;
            tail = newNode;
        } else {
            newNode.next = head;
            head = newNode;
        }
        size++;
    }
    public void addLast(int val)
    {
        if (size == 0) {
            head = newNode;
            tail = newNode;
        } else {
            tail.next = newNode;
            tail = newNode;
        }    //here tail is tracked since we write code for the build of ll 
        size++;
    }
    public void addatPos(int pos, int val)
    {
        Node curr=head;
        if (pos==0)
        {
            addFirst(val);
        }
        int i = 0;

    while(i < pos - 1)
    {
        curr = curr.next;
        i++;
    }
    
    if(curr != null) {
        Node newNode = new Node(val, curr.next);
        curr.next = newNode;
        if (newNode.next == null) {
            tail = newNode;
        }
        size++;
    }       

    public void deleteFirst()
    {
        if (size == 0) {
            return;
        }
        head = head.next;
        if (size == 1 || head==null) {
            tail = null;
        }
        size--;
    }

